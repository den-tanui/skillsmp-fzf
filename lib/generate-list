#!/usr/bin/env bash
set -euo pipefail

use_ansi=false
query=""
page=1
limit=100
mode="${SKILLSMCP_MODE:-api}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --ansi) use_ansi=true; shift ;;
    --query) query="${2:-}"; shift 2 ;;
    --query=*) query="${1#*=}"; shift ;;
    --page) page="$2"; shift 2 ;;
    --page=*) page="${1#*=}"; shift ;;
    --limit) limit="$2"; shift 2 ;;
    --limit=*) limit="${1#*=}"; shift ;;
    -*) shift ;;
    *) query="$1"; shift ;;
  esac
done

# URL encode query
encoded_query=""
if [[ -n "$query" ]]; then
  encoded_query=$(echo -n "$query" | jq -sRr @uri)
fi

json=$(curl -s "https://skillsmp.com/api/skills?page=$page&limit=$limit&sortBy=stars&search=$encoded_query")

total=$(echo "$json" | jq -r '.pagination.total // "?"')
count=$(echo "$json" | jq -r '[.skills[] | {githubUrl}] | length')

# Header line: count and keybindings
if [[ "$mode" == "api" ]]; then
  echo "$count/$total skills | Enter:Preview Ctrl+O:Browser Ctrl+G:Global Ctrl+L:Local Ctrl+M:More Ctrl+F:fzf ESC:Exit"
else
  echo "$count/$total skills | Enter:Preview Ctrl+O:Browser Ctrl+G:Global Ctrl+L:Local Ctrl+M:More Ctrl+F:API ESC:Exit"
fi

# Blank separator so --header-lines=2 doesn't consume the first item
echo ""

color_start=""
color_end=""
if [[ "$use_ansi" == "true" ]]; then
  color_start="\033[1;36m"
  color_end="\033[0m"
fi

echo "$json" | jq -r '[.skills[] | {githubUrl, name, description}] | .[] | "\(.githubUrl)|\(.name)|\(.description // "" | gsub("\n"; " "))"' \
  | awk -F'|' -v cs="$color_start" -v ce="$color_end" '{
      gsub(/-/," ",$2)
      n=split($2,w," "); name=""
      for(i=1;i<=n;i++) name=name (i>1?" ":"") toupper(substr(w[i],1,1)) tolower(substr(w[i],2))
      desc=$3
      if(desc=="") printf "%s|%s%s%s\n",$1,cs,name,ce
      else printf "%s|%s%s%s - %s\n",$1,cs,name,ce,desc
    }' \
  | grep -v '^$' | grep -v '^|'
